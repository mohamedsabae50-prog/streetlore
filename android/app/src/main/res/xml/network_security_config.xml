<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.0.78: relaxed network-security config.
  The previous strict-HTTPS config (v1.0.76) was likely causing
  silent TLS handshake failures on some production devices.
  We now allow cleartext as a last-resort fallback so any proxy
  or captive-portal on the user's network doesn't break tile
  loading. We still use HTTPS URLs in the Flutter code, so the
  cleartext flag is a safety net, not a default.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>